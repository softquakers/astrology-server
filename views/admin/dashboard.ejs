<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Astro Reports — Admin Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0c0919;
      --card-bg: #15102a;
      --card-bg-hover: #1c1638;
      --border: #29224d;
      --border-focus: #e8b86b;
      --text: #ede9fa;
      --text-muted: #968fb8;
      --gold: #e8b86b;
      --gold-light: #ffe0a3;
      --gold-glow: rgba(232, 184, 107, 0.15);
      --green: #10b981;
      --green-bg: rgba(16, 185, 129, 0.12);
      --green-border: rgba(16, 185, 129, 0.3);
      --red: #ef4444;
      --red-bg: rgba(239, 68, 68, 0.12);
      --red-border: rgba(239, 68, 68, 0.3);
      --amber: #f59e0b;
      --amber-bg: rgba(245, 158, 11, 0.12);
      --amber-border: rgba(245, 158, 11, 0.3);
      --purple: #8b5cf6;
      --purple-bg: rgba(139, 92, 246, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      line-height: 1.5;
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(139, 92, 246, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 85% 25%, rgba(232, 184, 107, 0.06) 0%, transparent 45%);
    }

    /* Top Navigation */
    .navbar {
      border-bottom: 1px solid var(--border);
      background: rgba(21, 16, 42, 0.8);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 50;
      padding: 0.85rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 1.25rem;
      letter-spacing: -0.01em;
      color: var(--text);
      text-decoration: none;
    }

    .brand-badge {
      background: linear-gradient(135deg, var(--gold), #ffd384);
      color: #1a1230;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      box-shadow: 0 4px 12px var(--gold-glow);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid transparent;
    }

    .status-badge.connected {
      background: var(--green-bg);
      color: var(--green);
      border-color: var(--green-border);
    }

    .status-badge.disconnected {
      background: var(--red-bg);
      color: var(--red);
      border-color: var(--red-border);
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
    }

    .status-badge.connected .status-dot {
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.15); }
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.55rem 1.1rem;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      border: none;
      font-family: inherit;
    }

    .btn-gold {
      background: var(--gold);
      color: #1a1230;
    }
    .btn-gold:hover {
      background: var(--gold-light);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px var(--gold-glow);
    }

    .btn-secondary {
      background: #231b40;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-secondary:hover {
      background: #2d2352;
      border-color: #3b3068;
    }

    .btn-sm {
      padding: 0.3rem 0.65rem;
      font-size: 0.75rem;
      border-radius: 6px;
    }

    .btn-success-sm {
      background: var(--green-bg);
      color: var(--green);
      border: 1px solid var(--green-border);
    }
    .btn-success-sm:hover {
      background: var(--green);
      color: #063d27;
    }

    .btn-danger-sm {
      background: var(--red-bg);
      color: var(--red);
      border: 1px solid var(--red-border);
    }
    .btn-danger-sm:hover {
      background: var(--red);
      color: #fff;
    }

    /* Container */
    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    /* Alert */
    .alert {
      padding: 1rem 1.25rem;
      border-radius: 12px;
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.9rem;
      border: 1px solid transparent;
      animation: fadeIn 0.3s ease;
    }
    .alert-success {
      background: var(--green-bg);
      border-color: var(--green-border);
      color: #a7f3d0;
    }
    .alert-warning {
      background: var(--amber-bg);
      border-color: var(--amber-border);
      color: #fde68a;
    }
    .alert-error {
      background: var(--red-bg);
      border-color: var(--red-border);
      color: #fecaca;
    }

    /* Page Header */
    .header-section {
      margin-bottom: 2rem;
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
    }

    .header-title h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .header-title p {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-top: 0.25rem;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .metric-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      transition: all 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    .metric-card:hover {
      border-color: #3d336a;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: transparent;
    }

    .metric-card.total::before { background: linear-gradient(90deg, #6366f1, #a855f7); }
    .metric-card.subscribed::before { background: linear-gradient(90deg, #10b981, #059669); }
    .metric-card.unpaid::before { background: linear-gradient(90deg, #ef4444, #f97316); }
    .metric-card.free::before { background: linear-gradient(90deg, var(--gold), #f59e0b); }

    .metric-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .metric-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .metric-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }

    .metric-card.total .metric-icon { background: var(--purple-bg); color: #c084fc; }
    .metric-card.subscribed .metric-icon { background: var(--green-bg); color: #34d399; }
    .metric-card.unpaid .metric-icon { background: var(--red-bg); color: #f87171; }
    .metric-card.free .metric-icon { background: var(--gold-glow); color: var(--gold); }

    .metric-value {
      font-family: 'Outfit', sans-serif;
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1;
      margin-bottom: 0.5rem;
    }

    .metric-card.subscribed .metric-value { color: #34d399; }
    .metric-card.unpaid .metric-value { color: #f87171; }

    .metric-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-muted);
      border-top: 1px solid rgba(41, 34, 77, 0.6);
      padding-top: 0.75rem;
      margin-top: 0.75rem;
    }

    .metric-highlight {
      font-weight: 600;
      color: var(--text);
    }

    /* Subscription Ratio Bar */
    .ratio-bar-wrapper {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 2rem;
    }

    .ratio-bar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
    }

    .ratio-bar {
      height: 10px;
      width: 100%;
      background: #231b40;
      border-radius: 999px;
      overflow: hidden;
      display: flex;
    }

    .ratio-seg {
      height: 100%;
      transition: width 0.4s ease;
    }
    .ratio-seg.paid { background: #10b981; }
    .ratio-seg.unpaid { background: #ef4444; }
    .ratio-seg.free { background: var(--gold); }

    .ratio-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-top: 0.85rem;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    /* Table Section */
    .table-section {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }

    .table-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    /* Filters */
    .filter-tabs {
      display: flex;
      gap: 0.5rem;
      background: #0f0b22;
      padding: 0.3rem;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    .filter-tab {
      padding: 0.4rem 0.9rem;
      border-radius: 7px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      text-decoration: none;
      transition: all 0.2s;
    }
    .filter-tab:hover {
      color: var(--text);
    }
    .filter-tab.active {
      background: var(--gold);
      color: #1a1230;
      box-shadow: 0 2px 8px var(--gold-glow);
    }

    .search-form {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .search-input {
      background: #0f0b22;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.45rem 0.85rem;
      font-size: 0.85rem;
      color: var(--text);
      outline: none;
      min-width: 220px;
    }
    .search-input:focus {
      border-color: var(--border-focus);
    }

    /* Table styling */
    .table-responsive {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.88rem;
    }

    th {
      background: rgba(15, 11, 34, 0.7);
      padding: 0.9rem 1.25rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
      font-weight: 600;
    }

    td {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid rgba(41, 34, 77, 0.5);
      vertical-align: middle;
    }

    tr:hover td {
      background: var(--card-bg-hover);
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .user-avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #2e265c, #44377a);
      color: var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.9rem;
      border: 1px solid #4a3e80;
    }

    .user-details .user-name {
      font-weight: 600;
      color: var(--text);
    }
    .user-details .user-email {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    /* Status Pill Badges */
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: capitalize;
    }

    .pill.active {
      background: var(--green-bg);
      color: #34d399;
      border: 1px solid var(--green-border);
    }
    .pill.unpaid {
      background: var(--red-bg);
      color: #f87171;
      border: 1px solid var(--red-border);
    }
    .pill.past_due {
      background: var(--amber-bg);
      color: #fbbf24;
      border: 1px solid var(--amber-border);
    }
    .pill.free {
      background: rgba(148, 163, 184, 0.12);
      color: #94a3b8;
      border: 1px solid rgba(148, 163, 184, 0.25);
    }
    .pill.canceled {
      background: rgba(100, 116, 139, 0.15);
      color: #94a3b8;
      border: 1px solid rgba(100, 116, 139, 0.25);
    }

    .actions-group {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* Empty state */
    .empty-state {
      padding: 4rem 2rem;
      text-align: center;
    }
    .empty-state-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }
    .empty-state h3 {
      font-size: 1.25rem;
      font-family: 'Outfit', sans-serif;
      margin-bottom: 0.5rem;
    }
    .empty-state p {
      color: var(--text-muted);
      font-size: 0.9rem;
      max-width: 420px;
      margin: 0 auto 1.5rem;
    }

    /* Create User Modal / Box */
    .collapsible-box {
      background: #110d24;
      border-top: 1px solid var(--border);
      padding: 1.5rem;
      display: none;
    }
    .collapsible-box.open {
      display: block;
      animation: fadeIn 0.2s ease;
    }

    .create-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      align-items: flex-end;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .form-group label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
    }
    .form-group input, .form-group select {
      background: #1a1438;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.55rem 0.85rem;
      font-size: 0.85rem;
      color: var(--text);
      outline: none;
    }
    .form-group input:focus, .form-group select:focus {
      border-color: var(--border-focus);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <!-- Top Navigation -->
  <header class="navbar">
    <a href="/admin" class="brand">
      <span class="brand-badge">✨</span>
      <span>Astro Reports Admin</span>
    </a>
    
    <div class="nav-actions">
      <% if (dbConnected) { %>
        <span class="status-badge connected" title="MongoDB Connected to <%= dbStatus.name %>">
          <span class="status-dot"></span>
          <span>MongoDB Live</span>
        </span>
      <% } else { %>
        <span class="status-badge disconnected" title="MongoDB Disconnected">
          <span class="status-dot"></span>
          <span>DB Offline</span>
        </span>
      <% } %>

      <form action="/admin/seed" method="POST" style="display:inline;">
        <button type="submit" class="btn btn-secondary btn-sm" title="Populate demo users with various payment statuses">
          🌱 Seed Demo Data
        </button>
      </form>

      <a href="http://localhost:3000" target="_blank" class="btn btn-gold btn-sm">
        📱 Open Client App ↗
      </a>
    </div>
  </header>

  <main class="container">

    <!-- Alert Notification -->
    <% if (alert) { %>
      <div class="alert alert-<%= alert.type %>">
        <span><%= alert.message %></span>
        <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;color:currentColor;cursor:pointer;font-size:1.1rem;">&times;</button>
      </div>
    <% } %>

    <!-- Header Section -->
    <div class="header-section">
      <div class="header-title">
        <h1>Celestial Subscription Overview</h1>
        <p>Monitor user registrations, monthly subscriptions, and unpaid subscription fees in real time.</p>
      </div>

      <div>
        <button type="button" class="btn btn-gold" onclick="toggleCreateDrawer()">
          + Add New User
        </button>
      </div>
    </div>

    <!-- 4 Key Metric Cards -->
    <div class="metrics-grid">
      
      <!-- CARD 1: Total Users Signed Up -->
      <div class="metric-card total">
        <div class="metric-header">
          <span class="metric-label">Signed Up Users</span>
          <div class="metric-icon">👥</div>
        </div>
        <div class="metric-value"><%= stats.totalUsers %></div>
        <div class="metric-footer">
          <span>All registered profiles</span>
          <span class="metric-highlight"><%= stats.totalCharts %> charts calculated</span>
        </div>
      </div>

      <!-- CARD 2: Subscribed Users -->
      <div class="metric-card subscribed">
        <div class="metric-header">
          <span class="metric-label">Subscribed (Paid)</span>
          <div class="metric-icon">💎</div>
        </div>
        <div class="metric-value"><%= stats.subscribedUsers %></div>
        <div class="metric-footer">
          <span>Paid MRR</span>
          <span class="metric-highlight" style="color: #34d399;">$<%= stats.mrr %>/mo</span>
        </div>
      </div>

      <!-- CARD 3: Unpaid Monthly Users -->
      <div class="metric-card unpaid">
        <div class="metric-header">
          <span class="metric-label">Unpaid Monthly Fee</span>
          <div class="metric-icon">⚠️</div>
        </div>
        <div class="metric-value"><%= stats.unpaidUsers %></div>
        <div class="metric-footer">
          <span>Overdue Fee Amount</span>
          <span class="metric-highlight" style="color: #f87171;">$<%= stats.unpaidRevenue %></span>
        </div>
      </div>

      <!-- CARD 4: Free Tier Users -->
      <div class="metric-card free">
        <div class="metric-header">
          <span class="metric-label">Free Tier Accounts</span>
          <div class="metric-icon">🌱</div>
        </div>
        <div class="metric-value"><%= stats.freeUsers %></div>
        <div class="metric-footer">
          <span>Paid Conversion</span>
          <span class="metric-highlight" style="color: var(--gold);"><%= stats.paidRate %>%</span>
        </div>
      </div>

    </div>

    <!-- Subscription Ratio Progress Bar -->
    <div class="ratio-bar-wrapper">
      <div class="ratio-bar-header">
        <span style="font-weight: 600; color: var(--text);">Subscription Distribution</span>
        <span style="color: var(--text-muted); font-size: 0.8rem;">
          <%= stats.subscribedUsers %> Paid &bull; <%= stats.unpaidUsers %> Unpaid &bull; <%= stats.freeUsers %> Free
        </span>
      </div>

      <% 
        const total = stats.totalUsers || 1;
        const paidPct = Math.round((stats.subscribedUsers / total) * 100);
        const unpaidPct = Math.round((stats.unpaidUsers / total) * 100);
        const freePct = 100 - paidPct - unpaidPct;
      %>

      <div class="ratio-bar">
        <div class="ratio-seg paid" style="width: <%= paidPct %>%;" title="Paid Subscribers: <%= paidPct %>%"></div>
        <div class="ratio-seg unpaid" style="width: <%= unpaidPct %>%;" title="Unpaid Monthly: <%= unpaidPct %>%"></div>
        <div class="ratio-seg free" style="width: <%= freePct %>%;" title="Free Tier: <%= freePct %>%"></div>
      </div>

      <div class="ratio-legend">
        <div class="legend-item">
          <span class="legend-dot" style="background:#10b981;"></span>
          <span>Active Paid Subscribers (<%= paidPct %>%)</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background:#ef4444;"></span>
          <span>Unpaid Monthly Fees (<%= unpaidPct %>%)</span>
        </div>
        <div class="legend-item">
          <span class="legend-dot" style="background:var(--gold);"></span>
          <span>Free Tier (<%= freePct %>%)</span>
        </div>
      </div>
    </div>

    <!-- User Management Table Section -->
    <div class="table-section">
      
      <div class="table-header">
        
        <!-- Filter Tabs -->
        <div class="filter-tabs">
          <a href="/admin?filter=all" class="filter-tab <%= currentFilter === 'all' ? 'active' : '' %>">
            All Users (<%= stats.totalUsers %>)
          </a>
          <a href="/admin?filter=subscribed" class="filter-tab <%= currentFilter === 'subscribed' ? 'active' : '' %>">
            Subscribed (<%= stats.subscribedUsers %>)
          </a>
          <a href="/admin?filter=unpaid" class="filter-tab <%= currentFilter === 'unpaid' ? 'active' : '' %>">
            Unpaid Fee (<%= stats.unpaidUsers %>)
          </a>
          <a href="/admin?filter=free" class="filter-tab <%= currentFilter === 'free' ? 'active' : '' %>">
            Free Tier (<%= stats.freeUsers %>)
          </a>
        </div>

        <!-- Search Form -->
        <form action="/admin" method="GET" class="search-form">
          <input type="hidden" name="filter" value="<%= currentFilter %>">
          <input 
            type="text" 
            name="q" 
            class="search-input" 
            placeholder="Search name or email..." 
            value="<%= searchQuery %>"
          >
          <button type="submit" class="btn btn-secondary btn-sm">Search</button>
          <% if (searchQuery) { %>
            <a href="/admin?filter=<%= currentFilter %>" class="btn btn-secondary btn-sm">Clear</a>
          <% } %>
        </form>

      </div>

      <!-- Add User Drawer Form -->
      <div id="createDrawer" class="collapsible-box">
        <form action="/admin/users" method="POST">
          <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; margin-bottom: 1rem; color: var(--gold);">
            ✨ Register New User Profile
          </h3>
          <div class="create-grid">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" placeholder="e.g. Eleanor Vance" required>
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="e.g. eleanor@cosmic.io" required>
            </div>
            <div class="form-group">
              <label>Subscription Status</label>
              <select name="subscriptionStatus">
                <option value="active">Subscribed & Paid (Active)</option>
                <option value="unpaid">Subscription Due (Unpaid)</option>
                <option value="free" selected>Free Tier</option>
              </select>
            </div>
            <div class="form-group">
              <label>Monthly Fee ($)</label>
              <input type="number" step="0.01" name="monthlyFee" placeholder="9.99" value="9.99">
            </div>
            <div style="display:flex;gap:0.5rem;">
              <button type="submit" class="btn btn-gold btn-sm" style="height:38px;">Save User</button>
              <button type="button" class="btn btn-secondary btn-sm" style="height:38px;" onclick="toggleCreateDrawer()">Cancel</button>
            </div>
          </div>
        </form>
      </div>

      <!-- Table content -->
      <% if (users.length > 0) { %>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>User Details</th>
                <th>Plan</th>
                <th>Monthly Fee</th>
                <th>Payment Status</th>
                <th>Next Billing Date</th>
                <th>Registered</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(u) { %>
                <tr>
                  <td>
                    <div class="user-info">
                      <div class="user-avatar">
                        <%= (u.name || u.email).charAt(0).toUpperCase() %>
                      </div>
                      <div class="user-details">
                        <div class="user-name"><%= u.name || "Anonymous Celestial" %></div>
                        <div class="user-email"><%= u.email %></div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span style="font-weight: 500; text-transform: capitalize;">
                      <%= u.subscriptionPlan || "free" %>
                    </span>
                  </td>
                  <td>
                    <span style="font-weight: 600;">
                      $<%= (u.monthlyFee || 0).toFixed(2) %>/mo
                    </span>
                  </td>
                  <td>
                    <% if (u.subscriptionStatus === 'active') { %>
                      <span class="pill active">● Subscribed & Paid</span>
                    <% } else if (u.subscriptionStatus === 'unpaid') { %>
                      <span class="pill unpaid">▲ Monthly Unpaid</span>
                    <% } else if (u.subscriptionStatus === 'past_due') { %>
                      <span class="pill past_due">▲ Past Due</span>
                    <% } else if (u.subscriptionStatus === 'canceled') { %>
                      <span class="pill canceled">✕ Canceled</span>
                    <% } else { %>
                      <span class="pill free">○ Free Tier</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.nextBillingDate) { %>
                      <span style="font-size: 0.82rem; color: <%= new Date(u.nextBillingDate) < new Date() ? '#f87171' : 'var(--text-muted)' %>">
                        <%= new Date(u.nextBillingDate).toLocaleDateString() %>
                        <% if (new Date(u.nextBillingDate) < new Date()) { %>
                          <span style="font-size:0.7rem;font-weight:600;color:#f87171;">(Overdue)</span>
                        <% } %>
                      </span>
                    <% } else { %>
                      <span style="color: #64748b;">—</span>
                    <% } %>
                  </td>
                  <td style="color: var(--text-muted); font-size: 0.82rem;">
                    <%= new Date(u.createdAt).toLocaleDateString() %>
                  </td>
                  <td>
                    <div class="actions-group">
                      <% if (u.subscriptionStatus !== 'active') { %>
                        <form action="/admin/users/<%= u._id %>/subscription" method="POST" style="display:inline;">
                          <input type="hidden" name="action" value="mark_paid">
                          <button type="submit" class="btn btn-success-sm btn-sm" title="Mark as Paid Subscriber">
                            ✓ Mark Paid
                          </button>
                        </form>
                      <% } else { %>
                        <form action="/admin/users/<%= u._id %>/subscription" method="POST" style="display:inline;">
                          <input type="hidden" name="action" value="mark_unpaid">
                          <button type="submit" class="btn btn-danger-sm btn-sm" title="Mark Monthly Fee Unpaid">
                            ⚠️ Unpaid
                          </button>
                        </form>
                      <% } %>

                      <form action="/admin/users/<%= u._id %>/delete" method="POST" onsubmit="return confirm('Delete user <%= u.email %>?');" style="display:inline;">
                        <button type="submit" class="btn btn-secondary btn-sm" style="color:#ef4444;" title="Delete User">
                          🗑️
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <!-- Empty State -->
        <div class="empty-state">
          <div class="empty-state-icon">🌌</div>
          <h3>No Users Found</h3>
          <p>
            <% if (searchQuery) { %>
              No profiles matched your search "<%= searchQuery %>". Try searching a different keyword.
            <% } else if (currentFilter !== 'all') { %>
              No users currently match the "<%= currentFilter %>" filter category.
            <% } else { %>
              Your database currently has no user records. Seed sample users to test the dashboard immediately!
            <% } %>
          </p>

          <form action="/admin/seed" method="POST">
            <button type="submit" class="btn btn-gold">
              🌱 Seed Realistic Demo Users
            </button>
          </form>
        </div>
      <% } %>

    </div>

  </main>

  <script>
    function toggleCreateDrawer() {
      const drawer = document.getElementById('createDrawer');
      drawer.classList.toggle('open');
    }
  </script>

</body>
</html>
