<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>

  <!-- Top Navigation Bar -->
  <%- include('partials/navbar') %>

  <main class="container">

    <!-- Alert Notifications (Errors, Info, Warnings) -->
    <%- include('partials/alerts') %>

    <!-- Header Section with Title & New User Trigger -->
    <%- include('partials/header-section') %>

    <!-- 4 Key Metric Cards (Users, Subscriptions, Unpaid, Free) -->
    <%- include('partials/metrics-grid') %>

    <!-- Subscription Ratio Distribution Bar -->
    <%- include('partials/ratio-bar') %>

    <!-- Onboarding & Conversion Funnel (Launches, Name, Photo, DOB, TOB, Subscribed, Attached) -->
    <%- include('partials/funnel-section') %>

    <!-- User Management Table Section with Filter & Drawer -->
    <div class="table-section">
      <%- include('partials/user-filters') %>
      <%- include('partials/create-user-drawer') %>
      <%- include('partials/user-table') %>
    </div>

    <!-- Live Screen Attachment Installs Log -->
    <%- include('partials/screen-installs-section') %>

  </main>

  <!-- Client-side Scripts -->
  <%- include('partials/scripts') %>

</body>
</html>
