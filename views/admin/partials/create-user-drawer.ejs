<div id="createDrawer" class="collapsible-box">
  <form action="/admin/users" method="POST">
    <h3 style="font-family: 'Outfit', sans-serif; font-size: 1.1rem; margin-bottom: 1rem; color: var(--gold);">
      ✨ Register New User Profile
    </h3>
    <div class="create-grid">
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" placeholder="e.g. Eleanor Vance" required>
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" placeholder="e.g. eleanor@cosmic.io" required>
      </div>
      <div class="form-group">
        <label>Subscription Status</label>
        <select name="subscriptionStatus">
          <option value="active">Subscribed & Paid (Active)</option>
          <option value="unpaid">Subscription Due (Unpaid)</option>
          <option value="free" selected>Free Tier</option>
        </select>
      </div>
      <div class="form-group">
        <label>Monthly Fee ($)</label>
        <input type="number" step="0.01" name="monthlyFee" placeholder="9.99" value="9.99">
      </div>
      <div style="display:flex;gap:0.5rem;">
        <button type="submit" class="btn btn-gold btn-sm" style="height:38px;">Save User</button>
        <button type="button" class="btn btn-secondary btn-sm" style="height:38px;" onclick="toggleCreateDrawer()">Cancel</button>
      </div>
    </div>
  </form>
</div>
