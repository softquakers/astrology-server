:root {
  --bg: #0c0919;
  --card-bg: #15102a;
  --card-bg-hover: #1c1638;
  --border: #29224d;
  --border-focus: #e8b86b;
  --text: #ede9fa;
  --text-muted: #968fb8;
  --gold: #e8b86b;
  --gold-light: #ffe0a3;
  --gold-glow: rgba(232, 184, 107, 0.15);
  --green: #10b981;
  --green-bg: rgba(16, 185, 129, 0.12);
  --green-border: rgba(16, 185, 129, 0.3);
  --red: #ef4444;
  --red-bg: rgba(239, 68, 68, 0.12);
  --red-border: rgba(239, 68, 68, 0.3);
  --amber: #f59e0b;
  --amber-bg: rgba(245, 158, 11, 0.12);
  --amber-border: rgba(245, 158, 11, 0.3);
  --purple: #8b5cf6;
  --purple-bg: rgba(139, 92, 246, 0.12);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg);
  color: var(--text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  min-height: 100vh;
  line-height: 1.5;
  background-image: 
    radial-gradient(circle at 15% 15%, rgba(139, 92, 246, 0.08) 0%, transparent 40%),
    radial-gradient(circle at 85% 25%, rgba(232, 184, 107, 0.06) 0%, transparent 45%);
}

/* Top Navigation */
.navbar {
  border-bottom: 1px solid var(--border);
  background: rgba(21, 16, 42, 0.8);
  backdrop-filter: blur(12px);
  position: sticky;
  top: 0;
  z-index: 50;
  padding: 0.85rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: 'Outfit', sans-serif;
  font-weight: 700;
  font-size: 1.25rem;
  letter-spacing: -0.01em;
  color: var(--text);
  text-decoration: none;
}

.brand-badge {
  background: linear-gradient(135deg, var(--gold), #ffd384);
  color: #1a1230;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  box-shadow: 0 4px 12px var(--gold-glow);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 0.85rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  border: 1px solid transparent;
}

.status-badge.connected {
  background: var(--green-bg);
  color: var(--green);
  border-color: var(--green-border);
}

.status-badge.disconnected {
  background: var(--red-bg);
  color: var(--red);
  border-color: var(--red-border);
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}

.status-badge.connected .status-dot {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.15); }
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.55rem 1.1rem;
  border-radius: 10px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
  border: none;
  font-family: inherit;
}

.btn-gold {
  background: var(--gold);
  color: #1a1230;
}
.btn-gold:hover {
  background: var(--gold-light);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px var(--gold-glow);
}

.btn-secondary {
  background: #231b40;
  color: var(--text);
  border: 1px solid var(--border);
}
.btn-secondary:hover {
  background: #2d2352;
  border-color: #3b3068;
}

.btn-sm {
  padding: 0.3rem 0.65rem;
  font-size: 0.75rem;
  border-radius: 6px;
}

.btn-success-sm {
  background: var(--green-bg);
  color: var(--green);
  border: 1px solid var(--green-border);
}
.btn-success-sm:hover {
  background: var(--green);
  color: #063d27;
}

.btn-danger-sm {
  background: var(--red-bg);
  color: var(--red);
  border: 1px solid var(--red-border);
}
.btn-danger-sm:hover {
  background: var(--red);
  color: #fff;
}

/* Container */
.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

/* Alert */
.alert {
  padding: 1rem 1.25rem;
  border-radius: 12px;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.9rem;
  border: 1px solid transparent;
  animation: fadeIn 0.3s ease;
}
.alert-success {
  background: var(--green-bg);
  border-color: var(--green-border);
  color: #a7f3d0;
}
.alert-warning {
  background: var(--amber-bg);
  border-color: var(--amber-border);
  color: #fde68a;
}
.alert-error {
  background: var(--red-bg);
  border-color: var(--red-border);
  color: #fecaca;
}

/* Page Header */
.header-section {
  margin-bottom: 2rem;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
}

.header-title h1 {
  font-family: 'Outfit', sans-serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.header-title p {
  color: var(--text-muted);
  font-size: 0.95rem;
  margin-top: 0.25rem;
}

/* Metrics Grid */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.25rem;
  margin-bottom: 2rem;
}

.metric-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.5rem;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.metric-card:hover {
  border-color: #3d336a;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.metric-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: transparent;
}

.metric-card.total::before { background: linear-gradient(90deg, #6366f1, #a855f7); }
.metric-card.subscribed::before { background: linear-gradient(90deg, #10b981, #059669); }
.metric-card.unpaid::before { background: linear-gradient(90deg, #ef4444, #f97316); }
.metric-card.free::before { background: linear-gradient(90deg, var(--gold), #f59e0b); }
.metric-card.attached::before { background: linear-gradient(90deg, #3b82f6, #06b6d4); }

.metric-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.metric-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.metric-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
}

.metric-card.total .metric-icon { background: var(--purple-bg); color: #c084fc; }
.metric-card.subscribed .metric-icon { background: var(--green-bg); color: #34d399; }
.metric-card.unpaid .metric-icon { background: var(--red-bg); color: #f87171; }
.metric-card.free .metric-icon { background: var(--gold-glow); color: var(--gold); }
.metric-card.attached .metric-icon { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }

.metric-value {
  font-family: 'Outfit', sans-serif;
  font-size: 2.5rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: 0.5rem;
}

.metric-card.subscribed .metric-value { color: #34d399; }
.metric-card.unpaid .metric-value { color: #f87171; }

.metric-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.8rem;
  color: var(--text-muted);
  border-top: 1px solid rgba(41, 34, 77, 0.6);
  padding-top: 0.75rem;
  margin-top: 0.75rem;
}

.metric-highlight {
  font-weight: 600;
  color: var(--text);
}

/* Subscription Ratio Bar */
.ratio-bar-wrapper {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1.25rem 1.5rem;
  margin-bottom: 2rem;
}

.ratio-bar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
  font-size: 0.85rem;
}

.ratio-bar {
  height: 10px;
  width: 100%;
  background: #231b40;
  border-radius: 999px;
  overflow: hidden;
  display: flex;
}

.ratio-seg {
  height: 100%;
  transition: width 0.4s ease;
}
.ratio-seg.paid { background: #10b981; }
.ratio-seg.unpaid { background: #ef4444; }
.ratio-seg.free { background: var(--gold); }

.ratio-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-top: 0.85rem;
  font-size: 0.78rem;
  color: var(--text-muted);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}
.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

/* Table Section */
.table-section {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}

.table-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

/* Filters */
.filter-tabs {
  display: flex;
  gap: 0.5rem;
  background: #0f0b22;
  padding: 0.3rem;
  border-radius: 10px;
  border: 1px solid var(--border);
}

.filter-tab {
  padding: 0.4rem 0.9rem;
  border-radius: 7px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--text-muted);
  text-decoration: none;
  transition: all 0.2s;
}
.filter-tab:hover {
  color: var(--text);
}
.filter-tab.active {
  background: var(--gold);
  color: #1a1230;
  box-shadow: 0 2px 8px var(--gold-glow);
}

.search-form {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.search-input {
  background: #0f0b22;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.45rem 0.85rem;
  font-size: 0.85rem;
  color: var(--text);
  outline: none;
  min-width: 220px;
}
.search-input:focus {
  border-color: var(--border-focus);
}

/* Table styling */
.table-responsive {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.88rem;
}

th {
  background: rgba(15, 11, 34, 0.7);
  padding: 0.9rem 1.25rem;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  border-bottom: 1px solid var(--border);
  font-weight: 600;
}

td {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid rgba(41, 34, 77, 0.5);
  vertical-align: middle;
}

tr:hover td {
  background: var(--card-bg-hover);
}

.user-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.user-avatar {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: linear-gradient(135deg, #2e265c, #44377a);
  color: var(--gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.9rem;
  border: 1px solid #4a3e80;
}

.user-details .user-name {
  font-weight: 600;
  color: var(--text);
}
.user-details .user-email {
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* Status Pill Badges */
.pill {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem 0.65rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 600;
  text-transform: capitalize;
}

.pill.active {
  background: var(--green-bg);
  color: #34d399;
  border: 1px solid var(--green-border);
}
.pill.unpaid {
  background: var(--red-bg);
  color: #f87171;
  border: 1px solid var(--red-border);
}
.pill.past_due {
  background: var(--amber-bg);
  color: #fbbf24;
  border: 1px solid var(--amber-border);
}
.pill.free {
  background: rgba(148, 163, 184, 0.12);
  color: #94a3b8;
  border: 1px solid rgba(148, 163, 184, 0.25);
}
.pill.attached {
  background: rgba(59, 130, 246, 0.15);
  color: #60a5fa;
  border: 1px solid rgba(59, 130, 246, 0.3);
}
.pill.canceled {
  background: rgba(100, 116, 139, 0.15);
  color: #94a3b8;
  border: 1px solid rgba(100, 116, 139, 0.25);
}

.actions-group {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

/* Empty state */
.empty-state {
  padding: 4rem 2rem;
  text-align: center;
}
.empty-state-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}
.empty-state h3 {
  font-size: 1.25rem;
  font-family: 'Outfit', sans-serif;
  margin-bottom: 0.5rem;
}
.empty-state p {
  color: var(--text-muted);
  font-size: 0.9rem;
  max-width: 420px;
  margin: 0 auto 1.5rem;
}

/* Create User Modal / Box */
.collapsible-box {
  background: #110d24;
  border-top: 1px solid var(--border);
  padding: 1.5rem;
  display: none;
}
.collapsible-box.open {
  display: block;
  animation: fadeIn 0.2s ease;
}

.create-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  align-items: flex-end;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.form-group label {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-muted);
}
.form-group input, .form-group select {
  background: #1a1438;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0.55rem 0.85rem;
  font-size: 0.85rem;
  color: var(--text);
  outline: none;
}
.form-group input:focus, .form-group select:focus {
  border-color: var(--border-focus);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* =====================================================================
   ONBOARDING & CONVERSION FUNNEL SECTION STYLES
   ===================================================================== */
.funnel-container {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.5rem;
  margin-bottom: 2rem;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  position: relative;
  overflow: hidden;
}

.funnel-container::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, #8b5cf6, #3b82f6, #10b981, var(--gold), #ec4899);
}

.funnel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 1.25rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.funnel-title-area {
  flex: 1;
  min-width: 280px;
}

.funnel-title-row {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  margin-bottom: 0.35rem;
  flex-wrap: wrap;
}

.funnel-icon-badge {
  font-size: 1.35rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.funnel-heading {
  font-family: 'Outfit', sans-serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.01em;
}

.funnel-live-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.2rem 0.65rem;
  border-radius: 9999px;
  font-size: 0.72rem;
  font-weight: 600;
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 8px #34d399;
  animation: pulse 1.8s infinite;
}

.funnel-subheading {
  font-size: 0.82rem;
  color: var(--text-muted);
  line-height: 1.45;
}

.funnel-subheading strong {
  color: #d1cbe5;
  font-weight: 600;
}

.funnel-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-sm {
  padding: 0.4rem 0.85rem;
  font-size: 0.78rem;
  border-radius: 8px;
}

/* Funnel Summary KPIs */
.funnel-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 0.85rem;
  margin-bottom: 1.5rem;
}

.funnel-kpi-card {
  background: rgba(26, 20, 56, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 0.85rem 1rem;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.funnel-kpi-card:hover {
  transform: translateY(-2px);
  border-color: rgba(232, 184, 107, 0.25);
}

.funnel-kpi-card .kpi-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 0.25rem;
}

.funnel-kpi-card .kpi-value {
  font-family: 'Outfit', sans-serif;
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1.2;
}

.funnel-kpi-card .kpi-sub {
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-top: 0.25rem;
}

/* Funnel Pipeline Visual Flow */
.funnel-pipeline {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 0.75rem;
  margin-bottom: 1.5rem;
  position: relative;
}

@media (min-width: 1100px) {
  .funnel-pipeline {
    grid-template-columns: repeat(7, minmax(0, 1fr));
  }
}

.funnel-step-card {
  background: #191333;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 1rem 0.9rem;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.funnel-step-card:hover {
  transform: translateY(-3px);
  border-color: var(--accent);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
}

.step-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.65rem;
}

.step-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem 0.55rem;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.75rem;
}

.step-number {
  font-family: 'Outfit', sans-serif;
  font-weight: 800;
}

.step-emoji {
  font-size: 0.95rem;
}

.step-retention-pill {
  font-size: 0.72rem;
  font-weight: 600;
}

.step-name {
  font-family: 'Outfit', sans-serif;
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--text);
  margin-bottom: 0.25rem;
}

.step-desc {
  font-size: 0.72rem;
  color: var(--text-muted);
  line-height: 1.35;
  min-height: 2rem;
  margin-bottom: 0.65rem;
}

.step-stat-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 0.45rem;
}

.step-count {
  font-family: 'Outfit', sans-serif;
  font-size: 1.45rem;
  font-weight: 800;
  color: var(--text);
}

.step-pct-total {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent);
}

/* Funnel Bar */
.funnel-bar-track {
  width: 100%;
  height: 8px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 9999px;
  overflow: hidden;
  margin-bottom: 0.65rem;
}

.funnel-bar-fill {
  height: 100%;
  border-radius: 9999px;
  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.15);
}

.step-dropoff-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.7rem;
  padding-top: 0.35rem;
  border-top: 1px dashed rgba(255, 255, 255, 0.08);
}

.dropoff-tag {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
  padding: 0.15rem 0.45rem;
  border-radius: 6px;
  border: 1px solid rgba(239, 68, 68, 0.25);
  font-weight: 600;
}

.dropoff-count {
  color: var(--text-muted);
  font-size: 0.68rem;
}

.funnel-arrow-connector {
  display: none;
}

/* Detailed Funnel Table */
.funnel-table-wrapper {
  background: #110d24;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 1.1rem;
}

.funnel-table-title {
  font-family: 'Outfit', sans-serif;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 0.85rem;
}

.funnel-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.82rem;
}

.funnel-table th {
  text-align: left;
  padding: 0.65rem 0.85rem;
  color: var(--text-muted);
  font-weight: 600;
  border-bottom: 1px solid var(--border);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.funnel-table td {
  padding: 0.75rem 0.85rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  vertical-align: middle;
}

.funnel-table tr:hover td {
  background: rgba(255, 255, 255, 0.02);
}

.tbl-step-pill {
  font-family: 'Outfit', sans-serif;
  font-weight: 700;
  font-size: 0.75rem;
  padding: 0.2rem 0.5rem;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.07);
  color: var(--text);
}

.tbl-stage-name {
  display: inline-flex;
  align-items: center;
  color: var(--text);
}

.tbl-progress-track {
  width: 100%;
  height: 7px;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 9999px;
  overflow: hidden;
}

.tbl-progress-fill {
  height: 100%;
  border-radius: 9999px;
  transition: width 0.4s ease;
}

@media (max-width: 768px) {
  .funnel-pipeline {
    grid-template-columns: 1fr;
  }
  .funnel-kpi-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

