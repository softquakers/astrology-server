PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Configuration
# Local MongoDB: mongodb://localhost:27017/astrology_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/astrology_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/astrology_db
MONGODB_DB_NAME=astrologydb

# Cloudflare R2 Object Storage Configuration
# Cloudflare Account ID from dashboard overview / R2 page
R2_ACCOUNT_ID=800be799787718b0fc31b2ed217b8f60
# R2 API Tokens generated in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=3b5ead6fcc2d54624855c10701ac279f
R2_SECRET_ACCESS_KEY=88100a2e4fc0b7776dc1dd6d298cb66a8803111d7623bce6021b7dd2f19466b8
# Bucket name requested: astrologybuckets
R2_BUCKET_NAME=astrologybuckets
# Folder name requested: astro-users
R2_FOLDER_NAME=astro-users
# Optional: Public bucket URL or Custom Domain (e.g. https://pub-xxxx.r2.dev or https://cdn.example.com)
# If left empty, photos are automatically served via the server proxy route /api/photos/astro-users/...
R2_PUBLIC_URL=https://pub-6d454bcf6b5f481b8c11d3a1b9a77397.r2.dev
